# Gemini AI API Key สำหรับโค้ชอัจฉริยะ
GEMINI_API_KEY=

# LINE Messaging API (LINE Bot / Webhook)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login (OAuth 2.1)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Session Secret (คีย์สำหรับลงลายมือชื่อ Cookie Session)
SESSION_SECRET=

# App URL เช่น https://fitcoach-ai.onrender.com หรือ http://localhost:3000
APP_URL=

# ฐานข้อมูล Firebase Firestore (Service Account JSON string หรือ Base64 สำหรับ Render)
FIREBASE_SERVICE_ACCOUNT=

# Admin Key
ADMIN_KEY=

